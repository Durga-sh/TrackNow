# Kafka Configuration
KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=tracknow
KAFKA_GROUP_ID=tracknow-group

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/tracknow
MONGO_DB_NAME=tracknow
MONGO_USER=
MONGO_PASSWORD=

# Service Ports
ORDER_SERVICE_PORT=3001
STATUS_UPDATE_SERVICE_PORT=3002
WEBSOCKET_SERVICE_PORT=8080
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

# API Configuration
API_VERSION=v1
REQUEST_TIMEOUT=30000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000

# Kafka Topics
TOPIC_ORDER_CREATED=order.created
TOPIC_ORDER_UPDATED=order.updated
TOPIC_STATUS_CHANGED=order.status.changed

# Redis Keys Prefix
REDIS_KEY_PREFIX=tracknow:

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
